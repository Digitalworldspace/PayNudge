# Your live site address (no trailing slash), e.g. https://paynudge.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments: "polar" or "dodo". If unset, Polar is used when POLAR_ACCESS_TOKEN is set.
PAYMENT_PROVIDER=polar

# Polar: Settings > Developers > Organization Access Tokens, Products, Settings > Webhooks
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
# sandbox while testing, production for real customers
POLAR_ENVIRONMENT=production

# Dodo Payments (fallback): Developer > API Keys, Developer > Webhooks, Products
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID=
# test_mode while testing, live_mode when you start charging real customers
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Resend: API Keys, and a sender address on a domain you verified in Resend
RESEND_API_KEY=
RESEND_FROM=reminders@yourdomain.com

# Any long random text. Vercel sends it to the daily reminder job.
CRON_SECRET=

# Shown on the Terms, Privacy, Refund and Contact pages
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
